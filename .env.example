# Copy to .env and fill in. .env is gitignored.

# ── App / security ────────────────────────────────────────────
SECRET_KEY=generate-with-python-c-import-secrets-print-secrets.token_hex-32
DEBUG=False
DB_ECHO=False
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database (Railway Postgres) ───────────────────────────────
# Local dev: the DATABASE_PUBLIC_URL (proxy.rlwy.net). Prod on Railway: the
# internal ${{Postgres.DATABASE_URL}}. Paste raw postgresql:// — the app adds
# the +psycopg2 driver and sslmode.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway

# ── Groq (reasoning brain + benchmark Whisper) ────────────────
GROQ_API_KEY=gsk_...
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_LLM_MODEL_FAST=openai/gpt-oss-20b

# ── Sahara / Intron Voice (STT + TTS) ────────────────────────
SAHARA_API_KEY=...

# ── Web Push (proactive follow-up) — generate with: vapid --gen ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Base URL the follow-up push notifications deep-link back into (your frontend).
PUBLIC_APP_URL=http://localhost:3000
# Local dev: run the follow-up tick inside the API process. Prod: leave False
# and run `python -m app.worker.followup_tick` from a Railway cron.
INPROCESS_SCHEDULER=False
INPROCESS_SCHEDULER_MINUTES=15
# FOLLOWUP_QUIET_START=8  FOLLOWUP_QUIET_END=20  FOLLOWUP_MIN_GAP_HOURS=20  FOLLOWUP_MAX_ATTEMPTS=2

# ── Benchmark only (not needed to run the app) ───────────────
HF_TOKEN=hf_...
OPENAI_API_KEY=sk-...

# ── CORS + languages ────────────────────────────────────────
ALLOWED_ORIGINS_STR=http://localhost:3000,http://localhost:5173
SUPPORTED_LANGUAGES_STR=en,yo,ha,ig,pcm
